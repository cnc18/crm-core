# === Aplicacion ===
APP_NAME=crm-core
ENV=development
DEBUG=true

# === Base de datos ===
# Formato: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
# Postgres:  postgresql+psycopg://usuario:password@localhost:5432/crm_dev
# SQLite:    sqlite:///./crm.db
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/crm_dev

# === Seguridad ===
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Reglas de negocio ===
# Umbral para emitir el evento de "stock bajo"
STOCK_BAJO_UMBRAL=10
